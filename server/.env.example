# Copy to .env and adjust. Never commit .env.
# All settings are optional; defaults are shown.

KG_ENVIRONMENT=development

# The API has no authentication yet. Keep it on loopback.
KG_HOST=127.0.0.1
KG_PORT=8000
KG_ALLOW_REMOTE_BIND=false

# Comma-separated list of approved browser origins (no wildcards).
KG_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Defaults to server/data/kernelguard.db
# KG_DATABASE_URL=sqlite:///C:/path/to/kernelguard.db

KG_LOG_LEVEL=INFO
KG_LOG_JSON=true

# --- Collector ---
# Defaults to the Windows MachineGuid.
# KG_HOST_ID=
KG_COLLECTOR_SENSORS=sysmon,system,security
KG_COLLECTOR_INTERVAL_SECONDS=10
KG_COLLECTOR_BATCH_SIZE=200
KG_COLLECTOR_MAX_BATCHES_PER_CYCLE=10
# First run: true = read retained log history, false = start from newest record.
KG_COLLECTOR_READ_HISTORY=true

# Limits for oversized/hostile records
KG_MAX_EVENT_XML_BYTES=262144
KG_MAX_FIELD_CHARS=8192
# Raw XML enables "view original event" but roughly doubles storage and may
# contain sensitive command lines.
KG_STORE_RAW_XML=true

# --- Detection ---
KG_DETECTION_ENABLED=true
# Rule overrides/allowlists; defaults to server/config/detection/detection.json (optional).
# KG_DETECTION_CONFIG=C:/path/to/detection.json

# --- Retention (~4.7 KB/event with raw XML) ---
KG_EVENT_RETENTION_DAYS=30
KG_EVENT_MAX_ROWS=500000
